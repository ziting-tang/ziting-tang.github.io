---
/* src/pages/about.astro */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Ziting (Kay) Tang">
  <div class="normal-section about-section data-section fade-in-up visible" data-section>
    <div class="content-inner about-grid">
      
      <!-- Left Column (Narrow, sticky on desktop) -->
      <aside class="about-sidebar">
        <div class="photo-frame">
          <div class="photo-placeholder">
            <img src="/aboutme.jpg" alt="Ziting Tang in New York" />
          </div>
        </div>
        
        <p class="sidebar-bio">
          I am currently a Research Technician II at Rice University (Houston, TX), working on a CPRIT-funded Rice–MD Anderson project that applies machine learning to multimodal prostate cancer data, including hyperpolarized <sup>13</sup>C pyruvate MR spectroscopy data from patient-derived xenograft models. 
        </p>
        
        <div class="sidebar-links">
          <div class="link-item">
            <a href="mailto:zt21@rice.edu">Email ↗</a>
          </div>
          <div class="link-item">
            <a href="https://github.com/ziting-tang" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
          <div class="link-item">
            <a href="/CV_Ziting_Tang.pdf" download>Download CV ↗</a>
          </div>
        </div>
      </aside>

      <!-- Right Column (Wide) -->
      <main class="about-main">
        
        <!-- Section: Education -->
        <section class="resume-section">
          <h2 class="section-label">Education</h2>
          
            <div class="resume-entry full-width-entry">
            <div class="entry-line-1">
                <h3 class="entry-title">Master of Statistics</h3>
                <span class="entry-date">Aug 2022–May 2024</span>
            </div>
            <div class="entry-line-2">Rice University</div>
            </div>

            <div class="resume-entry full-width-entry">
            <div class="entry-line-1">
                <h3 class="entry-title">B.S. in Statistics</h3>
                <span class="entry-date">Sep 2016–Jul 2020</span>
            </div>
            <div class="entry-line-2">Zhongnan University of Economics and Law</div>
            </div>
        </section>

        <!-- Section: Experience -->
        <section class="resume-section">
          <h2 class="section-label">Research Experience</h2>

            <div class="resume-entry full-width-entry">
            <div class="entry-line-1">
                <h3 class="entry-title">Research Technician II</h3>
                <span class="entry-date">May 2025–Present</span>
            </div>
            <div class="entry-line-2">Rice University, Department of Statistics</div>
            <div class="entry-supervisors">
                <span class="sup-label">Supervisors</span>
                <span>Dr. Erzsébet Merényi <span class="sup-aff">(Rice)</span></span>
                <span class="sup-aff">·</span>
                <span>Dr. Pratip K. Bhattacharya <span class="sup-aff">(MD Anderson)</span></span>
            </div>
            <ul class="resume-bullets" style="margin-top: 0.75rem;">
                    <li>Built a pipeline that digests raw <strong>hyperpolarized MR spectroscopy</strong> data cubes from mice bearing patient-derived xenograft (PDX) tumors and distills them into <strong>metabolic signatures</strong> ready for input to machine learning. Adapted the same pipeline for <strong>NMR metabolomics</strong> data, with flexibility to apply to other omics data.</li>
                    <li>Developed an approach to <strong>correct artifacts</strong> in hyperpolarized MR spectra, which <strong>improved quantification</strong> of pyruvate-to-lactate conversion (significantly changing the lactate-to-pyruvate ratio in about 12% of scans, by up to about 67%) and enabled reliable inclusion of <strong>previously unusable data</strong> cubes.
                      <div class="pub-tags">
                        <a class="pub-tag" href="/publications#mics2026">MICS 2026 poster presented</a>
                        <a class="pub-tag" href="/publications#ismrm2027">ISMRM 2027 abstract submitted</a>
                        <a class="pub-tag" href="/publications#manuscript">Manuscript in preparation</a>
                      </div>
                    </li>
                    <li>Produced <strong>combined views</strong> of metabolic signatures, relevant metadata, and clustering results, to help facilitate <strong>identification</strong> of <strong>metabolically distinct</strong> prostate cancer subgroups.
                      <div class="pub-tags">
                        <a class="pub-tag" href="/publications#ismrm2026">ISMRM 2026</a>
                      </div>
                    </li>
            </ul>
            </div>
          

          <div class="resume-entry full-width-entry">
            <div class="entry-line-1">
                <h3 class="entry-title">Research Assistant</h3>
                <span class="entry-date">Jan 2024–May 2025</span>
            </div>
            <div class="entry-line-2">Rice University, Department of Statistics</div>
            <div class="entry-supervisors">
                <span class="sup-label">Supervisor</span>
                <span>Dr. Erzsébet Merényi <span class="sup-aff">(Rice)</span></span>
            </div>
            <ul class="resume-bullets" style="margin-top: 0.75rem;">
                <li>Surveyed <strong>graph measures</strong> that characterize the knowledge learned by Self-Organizing Maps (SOMs)&mdash;an <strong>unsupervised neural machine learning</strong> paradigm&mdash;through the so-called connectivity (CONN) graph, an advanced knowledge representation; led the summarization of over 30 measures we investigated.</li>
                <li>Implemented a <strong>repeatable, automated procedure</strong> that generates tables of these measures and maps across series of SOM states for various data sets, enabling <strong>systematic evaluation</strong> of the measures’ ability to identify the known best SOM state of each data set.</li>
                <li>Helped design <strong>vertex-level visualizations</strong> of proposed topology-violation and entropy measures, layered with the CONN graph on the SOM, for insightful representations of the contributions of individual SOM prototypes to <strong>model reliability</strong>.
                  <div class="pub-tags">
                    <a class="pub-tag" href="/publications#wsom+2026">WSOM+ 2026</a>
                  </div>
                </li>
              </ul>
            </div>

        </section>

        <section class="resume-section" style="margin-top: 1rem;">
        <h2 class="section-label">Skills</h2>
        <div class="skills-grid">
            <div class="skill-col">
            <h3 class="skill-category">Programming</h3>
            <ul class="skill-list">
                <li><span class="skill-name">R</span><span class="skill-sub">Shiny · devtools</span></li>
                <li><span class="skill-name">MATLAB</span></li>
                <li><span class="skill-name">Python</span><span class="skill-sub">PyTorch · scikit&#8209;learn · OpenCV</span></li>
                <li><span class="skill-name">SQL</span><span class="skill-sub">PostgreSQL</span></li>
                <li><span class="skill-name">Linux</span><span class="skill-sub">Bash</span></li>
                <li><span class="skill-name">Git</span></li>
            </ul>
            </div>
            <div class="skill-col">
            <h3 class="skill-category">Big Data & Cloud</h3>
            <ul class="skill-list">
                <li><span class="skill-name">Apache Spark</span><span class="skill-sub">PySpark</span></li>
                <li><span class="skill-name">AWS</span><span class="skill-sub">EMR · S3</span></li>
            </ul>

            <h3 class="skill-category" style="margin-top: 2rem;">Other Software</h3>
            <ul class="skill-list">
                <li><span class="skill-name">LaTeX</span></li>
                <li><span class="skill-name">Visio</span></li>
            </ul>
            </div>
            <div class="skill-col">
            <h3 class="skill-category">Languages</h3>
            <ul class="skill-list lang-list">
                <li><span class="skill-name">Mandarin</span><span class="skill-sub">Native</span></li>
                <li><span class="skill-name">English</span><span class="skill-sub">Proficient</span></li>
                <li><span class="skill-name">Korean</span><span class="skill-sub">Intermediate</span></li>
            </ul>
            </div>
        </div>
        </section>

        <!-- Section: Beyond Research -->
        <section class="resume-section" style="margin-top: 2rem;">
          <h2 class="section-label" >Beyond research</h2>
            <div class="entry-content">
              <div style ="font-size: 0.85rem; color: var(--text-secondary); padding-top: 1rem;">A vocalist and a hip-hop dancer. A cat person.</div>
            </div>
        </section>

      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .about-section {
    padding-top: calc(var(--header-height) + 2rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Left Column Styles */
  .about-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .photo-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  .photo-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 2px;
    overflow: hidden;
  }

  .photo-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sidebar-bio {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    text-align: justify;
    hyphens: auto;
    font-size: 0.85rem;
    sup {
    line-height: 0;
    }
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
  }

  .link-item {
    border-bottom: 1px solid var(--border-light);
  }

  .link-item a {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    padding: 0.65rem 0;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .link-item a:hover {
    color: var(--accent-primary);
    padding-left: 4px;
  }

  /* Right Column Styles */
  .about-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .resume-section {
    display: flex;
    flex-direction: column;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    text-transform: lowercase;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .resume-entry {
    padding: 1rem 0;
    border-top: 1px solid var(--border-light);
  }

  /* Full Width Entries (Education, TA) */
  .full-width-entry {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .entry-line-1 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
  }

  .entry-line-2 {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .entry-sep {
    color: var(--text-muted);
    margin: 0 0.25rem;
  }

  /* Two Column Entries (RA, Tech II) */
  .two-column-entry {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
  }

  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .entry-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.3;
  }


  .sup-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .sup-aff {
    color: var(--text-muted);
  }

  .entry-org, 
  .entry-location {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .entry-content {
    display: flex;
    flex-direction: column;
  }

    .entry-supervisors {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.74rem;
    color: var(--text-secondary);
    }

  .resume-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .resume-bullets li {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    position: relative;
    padding-left: 1rem;
    text-align: justify;
    hyphens: auto;
    hyphenate-limit-chars: 10 4 4;
  }

  .resume-bullets li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  .resume-bullets strong {
  font-weight: 500;
  color: var(--text-primary);
  }

  .pub-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.2rem;
  margin-left: -0.05rem;
  
}

.pub-tag {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  line-height: 1;
  padding: 0.35rem 0.55rem;
  border-radius: var(--radius-sm);
  background: #E5E5E5;
  color: var(--text-secondary);
  text-decoration: none;
  white-space: nowrap;
  hyphens: manual;
  transition: color 0.2s ease, box-shadow 0.2s ease;
}

:root[data-theme="dark"] .pub-tag {
  background: #262626;
}

.pub-tag:hover {
  color: var(--accent-primary);
  box-shadow: inset 0 0 0 1px var(--accent-primary);
}

  /* Skills Specific Styles */
    .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
    }

    .skill-category::before {
    content: "";
    width: 0.2rem;
    height: 0.7rem;
    background: var(--text-muted);
    flex-shrink: 0;
    }

    .skill-category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    }

    .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
    }

    .skill-list li {
    display: flex;
    flex-direction: column;
    }

    .skill-name {
    color: var(--text-secondary);
    font-size: 0.9rem;
    }

    .skill-sub {
    font-size: 0.65rem;
    color: var(--text-muted);
    }

    .lang-list li {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    }

  /* Placeholder Style */
  .placeholder-entry {
    display: flex;
    flex-direction: column;
  }

  .placeholder-text {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Responsive Breakdown */
  @media (max-width: 868px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about-sidebar {
      position: relative;
      top: 0;
      max-width: 450px;
    }

    .two-column-entry,
    .skills-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .entry-line-1 {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
