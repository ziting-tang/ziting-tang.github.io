---
/* src/pages/about.astro */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Ziting (Kay) Tang">
  <div class="normal-section about-section data-section fade-in-up visible" data-section>
    <div class="content-inner about-grid">
      
      <!-- Left Column (Narrow, sticky on desktop) -->
      <aside class="about-sidebar">
        <div class="photo-frame">
          <div class="photo-placeholder">
            <img src="/aboutme.jpg" alt="Ziting Tang in New York" />
          </div>
        </div>
        
        <p class="sidebar-bio">
          I am a Research Technician II at Rice University, working on a CPRIT-funded Rice–MD Anderson project that applies machine learning to hyperpolarized <sup>13</sup>C pyruvate MR data in prostate cancer models. 
        </p>
        
        <div class="sidebar-links">
          <div class="link-item">
            <a href="mailto:zt21@rice.edu">Email ↗</a>
          </div>
          <div class="link-item">
            <a href="https://github.com/ziting-tang" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
          <div class="link-item">
            <a href="/CV_Ziting_Tang.pdf" download>Download CV ↗</a>
          </div>
        </div>
      </aside>

      <!-- Right Column (Wide) -->
      <main class="about-main">
        
        <!-- Section: Education -->
        <section class="resume-section">
          <h2 class="section-label">Education</h2>
          
            <div class="resume-entry full-width-entry">
            <div class="entry-line-1">
                <h3 class="entry-title">Master of Statistics</h3>
                <span class="entry-date">Aug 2022–May 2024</span>
            </div>
            <div class="entry-line-2">Rice University<span class="entry-sep">·</span>Houston, TX</div>
            </div>

            <div class="resume-entry full-width-entry">
            <div class="entry-line-1">
                <h3 class="entry-title">B.S. in Statistics</h3>
                <span class="entry-date">Sep 2016–Jul 2020</span>
            </div>
            <div class="entry-line-2">Zhongnan University of Economics and Law<span class="entry-sep">·</span>Wuhan, China</div>
            </div>
        </section>

        <!-- Section: Experience -->
        <section class="resume-section">
          <h2 class="section-label">Research Experience</h2>
          
          <div class="resume-entry two-column-entry">
            <div class="entry-meta">
              <h3 class="entry-title">Research Technician II</h3>
              <div class="entry-org">Rice University, Department of Statistics</div>
              <div class="entry-date">May 2025–Present</div>
              <div class="entry-location">Supervisors: Drs. Erzsébet Merényi (Rice) and Pratip K. Bhattacharya (MD Anderson)</div>
            </div>
            <div class="entry-content">
              <ul class="resume-bullets">
                <li>Built a pipeline that digests raw hyperpolarized MR spectroscopy data cubes from mice bearing patient-derived xenograft (PDX) tumors and distills them into metabolic signatures ready for input to machine learning. Adapted the same pipeline for NMR metabolomics data, with flexibility to apply to other omics data.</li>
                <li>Developed an approach to correct artifacts in hyperpolarized MR spectra, which improved quantification of pyruvate-to-lactate conversion and enabled reliable inclusion of previously unusable data cubes (presented at MICS 2026; ISMRM 2027 abstract submitted; manuscript in preparation).</li>
                <li>Produced combined views of metabolic signatures, relevant metadata, and clustering results, to help facilitate identification of metabolically distinct prostate cancer subgroups (ISMRM 2026).</li>
              </ul>
            </div>
          </div>
          
          <div class="resume-entry two-column-entry">
            <div class="entry-meta">
              <h3 class="entry-title">Research Assistant</h3>
              <div class="entry-org">Rice University, Department of Statistics</div>
              <div class="entry-date">Jan 2024–May 2025</div>
              <div class="entry-location">Supervisor: Dr. Erzsébet Merényi</div>
            </div>
            <div class="entry-content">
              <ul class="resume-bullets">
                <li>Surveyed graph measures that characterize the knowledge learned by Self-Organizing Maps (SOMs) through the so-called connectivity (CONN) graph, an advanced knowledge representation; led the summarization of over 30 measures we investigated.</li>
                <li>Generated extensive Excel tables of these measures for different SOM states of various data sets, for subsequent systematic evaluation of the measures’ ability to identify the known best SOM state of each data set.</li>
                <li>Helped design vertex-level visualizations of proposed topology-violation and entropy measures, layered with the CONN graph on the SOM, for insightful representations of the contributions of individual SOM prototypes to model reliability (WSOM+ 2026).</li>
                <li>Built a repeatable, automated pipeline that mass-produces Excel sheets/tabs of several variants of the above graph measures, and maps, from series of SOM states.</li>
              </ul>
            </div>
          </div>

            <div class="resume-entry full-width-entry">
            <div class="entry-line-1">
                <h3 class="entry-title">Teaching Assistant</h3>
                <span class="entry-date">Jan 2023–Dec 2024</span>
            </div>
            <div class="entry-line-2">Rice University<span class="entry-sep">·</span>Neural Machine Learning I (Spring 2024, Fall 2024); R for Data Science (Spring 2023, Fall 2023)</div>
            </div>
        </section>

        <section class="resume-section">
        <h2 class="section-label">Skills</h2>
        <div class="skills-grid">
            <div class="skill-col">
            <h3 class="skill-category">Programming</h3>
            <ul class="skill-list">
                <li>R</li>
                <li>MATLAB</li>
                <li><span class="skill-name">Python</span><span class="skill-sub">PyTorch · scikit&#8209;learn · OpenCV</span></li>
                <li>SQL (PostgreSQL)</li>
                <li>Linux/Bash</li>
                <li>Git</li>
            </ul>
            </div>
            <div class="skill-col">
            <h3 class="skill-category">Big Data & Cloud</h3>
            <ul class="skill-list">
                <li>Apache Spark (PySpark)</li>
                <li>AWS (EMR, S3)</li>
            </ul>
            </div>
            <div class="skill-col">
            <h3 class="skill-category">Languages</h3>
            <ul class="skill-list">
                <li>Mandarin (Native)</li>
                <li>English (Proficient)</li>
                <li>Korean (Intermediate)</li>
            </ul>
            </div>
        </div>
        </section>

        <!-- Section: Beyond Research -->
        <section class="resume-section">
          <h2 class="section-label">Beyond research</h2>
          <div class="resume-entry placeholder-entry">
            <div class="entry-content">
              <div class="placeholder-text">A vocalist and a hiphop dancer.</div>
            </div>
          </div>
        </section>

      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .about-section {
    padding-top: calc(var(--header-height) + 2rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Left Column Styles */
  .about-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .photo-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  .photo-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 2px;
    overflow: hidden;
  }

  .photo-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sidebar-bio {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    text-align: left;
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
  }

  .link-item {
    border-bottom: 1px solid var(--border-light);
  }

  .link-item a {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    padding: 0.65rem 0;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .link-item a:hover {
    color: var(--accent-primary);
    padding-left: 4px;
  }

  /* Right Column Styles */
  .about-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .resume-section {
    display: flex;
    flex-direction: column;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    text-transform: lowercase;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .resume-entry {
    padding: 1rem 0;
    border-top: 1px solid var(--border-light);
  }

  /* Full Width Entries (Education, TA) */
  .full-width-entry {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .entry-line-1 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
  }

  .entry-line-2 {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .entry-sep {
    color: var(--text-muted);
    margin: 0 0.25rem;
  }

  /* Two Column Entries (RA, Tech II) */
  .two-column-entry {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
  }

  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .entry-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .entry-org, 
  .entry-location {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .entry-content {
    display: flex;
    flex-direction: column;
  }

  .resume-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .resume-bullets li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    position: relative;
    padding-left: 1rem;
  }

  .resume-bullets li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  /* Skills Specific Styles */
    .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
    }

    .skill-category {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
    }

    .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
    }

    .skill-list li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    }

    .skill-name {
    color: var(--text-primary);
    font-size: 0.9rem;
    }

    .skill-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    }

  /* Placeholder Style */
  .placeholder-entry {
    display: flex;
    flex-direction: column;
  }

  .placeholder-text {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Responsive Breakdown */
  @media (max-width: 868px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about-sidebar {
      position: relative;
      top: 0;
      max-width: 450px;
    }

    .two-column-entry,
    .skills-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .entry-line-1 {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
