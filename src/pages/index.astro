---
/* src/pages/index.astro */
import BaseLayout from '../layouts/BaseLayout.astro';
import TechnicalHero from '../components/TechnicalHero.astro';
import LabSection from '../components/LabSection.astro';
import ResearchFigure from '../components/figures/ResearchFigure.astro';
import NotesFigure from '../components/figures/NotesFigure.astro';
import ProjectsFigure from '../components/figures/ProjectsFigure.astro';
import publicationsData from '../data/publications.json';

const recentPublications = publicationsData.slice(0, 3);
---

<BaseLayout title="Ziting (Kay) Tang">
  <TechnicalHero />
</BaseLayout>

<script>
  /* 
    Simple Viewport Entrance Fade-In
    File: src/pages/index.astro
    Smoothly fades in each section as it scrolls into view.
  */
  function initFadeObserver() {
    const sections = document.querySelectorAll('[data-section]');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.15 });

    sections.forEach(sec => observer.observe(sec));

    // Active caption observer
    const activeObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const caption = entry.target.querySelector('[data-caption]');
        if (caption) {
          if (entry.isIntersecting) {
            caption.classList.add('active');
          } else {
            caption.classList.remove('active');
          }
        }
      });
    }, { threshold: 0.5, rootMargin: '-20% 0px -20% 0px' });

    sections.forEach(sec => activeObserver.observe(sec));
  }

  initFadeObserver();
  document.addEventListener('astro:after-swap', initFadeObserver);
</script>

<style>
  .pub-list-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .clean-pub-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .clean-pub-list li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .pub-year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .pub-details {
    line-height: 1.4;
  }

  .pub-title {
    color: var(--text-primary);
  }

  .pub-venue {
    color: var(--text-muted);
  }

  .all-pubs-link-wrapper {
    margin-top: 0.5rem;
  }

  .mono-all-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-primary);
  }

  .mono-all-link:hover {
    text-decoration: underline;
  }
</style>