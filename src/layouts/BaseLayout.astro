---
/* 
  src/layouts/BaseLayout.astro
  Base layout with frosted glass fixed header ("Z.TANG" logo, nav items with About, theme toggle).
*/
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- read theme ahead to avoid refresh flashing -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    </script>
  </head>
  <body>
    <!-- Frosted Glass Fixed Header -->
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-logo">Z.TANG</a>
        
        <div class="header-right">
          <nav class="site-nav">
            <a href="/research">Research</a>
            <a href="/notes">Notes</a>
            <a href="/projects">Projects</a>
            <a href="/publications">Publications</a>
            <a href="/about">About</a>
          </nav>

          <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme">
            <!-- Sun icon for dark mode -->
            <svg class="sun-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon for light mode -->
            <svg class="moon-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Flow -->
    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>&copy; {new Date().getFullYear()} Ziting (Kay) Tang</p>
      </div>
    </footer>

    <script>
      /* Theme Toggle Script */
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const html = document.documentElement;
        const currentTheme = html.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Restore saved theme on load
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

/* Frosted Glass Header Styling */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    z-index: 1000;
    display: flex;
    align-items: center;
    
    /* Frosted glass background using theme variable and blur */
    background-color: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    
    /* Thin 1px bottom border */
    border-bottom: 1px solid var(--border-color);
    box-shadow: var(--header-shadow);
  }

  /* Dark mode frosted glass background adjustment */
  :root[data-theme="dark"] .site-header {
    background-color: rgba(10, 10, 10, 0.82); /* Dark mode semi-transparent */
  }

  .header-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo: Monospace, semi-bold, uppercase, tightened letter spacing */
  .site-logo {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-nav {
    display: flex;
    gap: 1.5rem;
  }

  .site-nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .site-nav a:hover {
    color: var(--accent-primary);
  }

  /* Theme Toggle Button Style */
  .theme-toggle-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    transition: color 0.2s ease;
  }

  .theme-toggle-btn:hover {
    color: var(--accent-primary);
  }

  /* Icon visibility toggling based on active theme */
  .moon-icon { display: none; }
  .sun-icon { display: block; }

  :root[data-theme="dark"] .sun-icon { display: none; }
  :root[data-theme="dark"] .moon-icon { display: block; }

  .site-main {
    padding-top: var(--header-height);
    min-height: 100vh;
  }

  .site-footer {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-light);
  }

  @media (max-width: 640px) {
    .header-right {
      gap: 1rem;
    }
    .site-nav {
      gap: 1rem;
    }
    .site-nav a {
      font-size: 0.75rem;
    }
  }
</style>