---
/* 
  src/components/LabSection.astro
  Normal flow lab notebook section with fade-in animation.
*/
interface Props {
  title: string;
  description: string;
  href: string;
  captionText: string;
  hasFigure?: boolean;
}

const { title, description, href, captionText, hasFigure = true } = Astro.props;
---

<section class="lab-section normal-section fade-in-up" data-section>
  <div class="content-inner section-container">
    <div class="section-header">
      <h2 class="section-title">
        <a href={href}>{title} &rarr;</a>
      </h2>
      <p class="section-desc">{description}</p>
    </div>

    {hasFigure ? (
      <div class="crop-figure-frame">
        <div class="crop-mark tl"></div>
        <div class="crop-mark tr"></div>
        <div class="crop-mark bl"></div>
        <div class="crop-mark br"></div>

        <div class="figure-inner-content">
          <slot />
        </div>
      </div>
    ) : (
      <div class="pub-slot-container">
        <slot />
      </div>
    )}

    <div class="paper-caption" data-caption>
      <span class="caption-label">{captionText.split('—')[0].trim()}</span> — {captionText.split('—')[1]?.trim() || captionText}
    </div>
  </div>
</section>

<style>
  .lab-section {
    background-color: var(--bg-primary);
  }

  .section-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .section-title a:hover {
    color: var(--accent-primary);
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.5;
    max-width: 600px;
  }

  .crop-figure-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 360px;
    background-color: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .crop-mark {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: var(--text-muted);
    border-style: solid;
  }
  .tl { top: 6px; left: 6px; border-width: 1px 0 0 1px; }
  .tr { top: 6px; right: 6px; border-width: 1px 1px 0 0; }
  .bl { bottom: 6px; left: 6px; border-width: 0 0 1px 1px; }
  .br { bottom: 6px; right: 6px; border-width: 0 1px 1px 0; }

  .figure-inner-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pub-slot-container {
    width: 100%;
    background-color: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
  }

  .paper-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.03em;
    margin-top: 0.65rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: left;
  }

  .caption-label {
    color: var(--text-muted);
    transition: color 0.3s ease;
  }

  .paper-caption.active .caption-label {
    color: var(--accent-primary);
  }

  @media (max-width: 768px) {
    .crop-figure-frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>