---
/* 
  src/components/TechnicalHero.astro
  Hero section with two-row keyword tags, signal sweep, multi-pulses, and configurable timings.
*/
const row1Keywords = [
  { text: "Machine Learning", class: "tag-1" },
  { text: "Statistics", class: "tag-2" },
  { text: "Computing", class: "tag-3" }
];

const row2Keywords = [
  { text: "Graph Methods", class: "tag-4" },
  { text: "Biomedical Data", class: "tag-5" }
];
---

<div class="normal-section hero-section fade-in-up visible" data-section>
  <!-- Background Neural Network Band aligned to inner content container for symmetric margins -->
  <div class="hero-network-band" aria-hidden="true">
    <svg 
      id="hero-band-svg" 
      viewBox="0 0 1000 400" 
      preserveAspectRatio="none"
      width="100%" 
      height="100%"
    >
      <defs>
        <linearGradient id="bandFadeMask" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#fff" stop-opacity="0.0" />
          <stop offset="25%" stop-color="#fff" stop-opacity="0.05" />
          <stop offset="55%" stop-color="#fff" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#fff" stop-opacity="1.0" />
        </linearGradient>
        <mask id="bandMask">
          <rect x="0" y="0" width="1000" height="400" fill="url(#bandFadeMask)" />
        </mask>
        <defs id="line-gradients-defs"></defs>
      </defs>

      <g mask="url(#bandMask)">
        <g id="band-connections"></g>
        <g id="band-pulses"></g>
      </g>
    </svg>

    <div id="html-nodes-layer" class="html-nodes-layer"></div>
  </div>

  <div class="content-inner hero-content">
    <div class="hero-text-block">
      <h1 class="name-title">Ziting (Kay) Tang</h1>
      <p class="hero-body">
        I work on machine learning for high-dimensional biomedical data, especially multimodal analysis of imaging and omics data.
      </p>

      <div class="keyword-tags-container">
        <div class="keyword-row">
          {row1Keywords.map(kw => (
            <span class={`tag ${kw.class}`}>{kw.text}</span>
          ))}
        </div>
        <div class="keyword-row">
          {row2Keywords.map(kw => (
            <span class={`tag ${kw.class}`}>{kw.text}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const TIMINGS = {
    loadSweepDurationMs: 2800,
    pulseIntervalMinMs: 8000,
    pulseIntervalMaxMs: 10000,
    pulseTravelDurationMs: 1800,
    pulseBatchMinCount: 1,
    pulseBatchMaxCount: 3,
    pulseBatchStaggerMaxMs: 400,
    outputBreathingCycleMin: 3.2,
    middleWaveBreathingCycle: 5.5,
    subtleBreathingCycle: 5.0,
  };

  function initHeroBand() {
    const svg = document.getElementById('hero-band-svg');
    const defsEl = document.getElementById('line-gradients-defs');
    const connLayer = document.getElementById('band-connections');
    const pulsesLayer = document.getElementById('band-pulses');
    const htmlNodesContainer = document.getElementById('html-nodes-layer');

    if (!svg || !defsEl || !connLayer || !pulsesLayer || !htmlNodesContainer) return;

    connLayer.innerHTML = '';
    pulsesLayer.innerHTML = '';
    htmlNodesContainer.innerHTML = '';

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let seed = 1337;
    function seededRandom() {
      seed = (seed * 9301 + 49297) % 233280;
      return seed / 233280;
    }

    function getUniqueRandomIndices(max, count) {
      const indices = [];
      while (indices.length < count && indices.length < max) {
        const idx = Math.floor(seededRandom() * max);
        if (!indices.includes(idx)) indices.push(idx);
      }
      return indices;
    }

    const layers = [
      [
        { x: 20, y: 88, size: 3, opacity: 0.18, tone: '#a1a1a1' },
        { x: 20, y: 162, size: 3, opacity: 0.15, tone: '#b0b0b0' },
        { x: 20, y: 238, size: 3, opacity: 0.20, tone: '#a1a1a1' },
        { x: 20, y: 312, size: 3, opacity: 0.15, tone: '#b0b0b0' }
      ],
      [
        { x: 620, y: 52, size: 5, opacity: 0.5, tone: '#737373', isMiddle: true },
        { x: 620, y: 102, size: 5, opacity: 0.5, tone: '#737373', isMiddle: true },
        { x: 620, y: 158, size: 5, opacity: 0.5, tone: '#666666', isMiddle: true },
        { x: 620, y: 205, size: 5, opacity: 0.5, tone: '#737373', isMiddle: true },
        { x: 620, y: 258, size: 5, opacity: 0.5, tone: '#666666', isMiddle: true },
        { x: 620, y: 308, size: 5, opacity: 0.5, tone: '#737373', isMiddle: true },
        { x: 620, y: 352, size: 5, opacity: 0.5, tone: '#666666', isMiddle: true }
      ],
      [
        { x: 980, y: 110, size: 8, isOutput: true, colorType: 'gray', tone: '#525252' },
        { x: 980, y: 150, size: 8, isOutput: true, colorType: 'denim' },
        { x: 980, y: 200, size: 8, isOutput: true, colorType: 'camel' },
        { x: 980, y: 250, size: 8, isOutput: true, colorType: 'denim' },
        { x: 980, y: 290, size: 8, isOutput: true, colorType: 'gray', tone: '#303030' }
      ]
    ];

    const getCssVar = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    const signalPathsFirstToMid = [
      { inIdx: 0, midIdx: 5 },
      { inIdx: 3, midIdx: 1 },
      { inIdx: 1, midIdx: 0 }
    ];

    const signalPathsMidToOut = [
      { midIdx: 5, outIdx: 1 },
      { midIdx: 1, outIdx: 2 },
      { midIdx: 0, outIdx: 3 }
    ];

    // 1. Build initial connections using original random generation logic
    const inToMidConnections: { inIdx: number; midIdx: number; isSignal: boolean }[] = [];

    layers[0].forEach((_, i) => {
      const connectedMiddleIndices = getUniqueRandomIndices(layers[1].length, 2 + Math.floor(seededRandom() * 2));
      layers[1].forEach((_, j) => {
        const isSignalPath = signalPathsFirstToMid.some(p => p.inIdx === i && p.midIdx === j);
        const isConnected = connectedMiddleIndices.includes(j) || isSignalPath;
        if (isConnected) {
          if (!inToMidConnections.some(c => c.inIdx === i && c.midIdx === j)) {
            inToMidConnections.push({ inIdx: i, midIdx: j, isSignal: isSignalPath });
          }
        }
      });
    });

    signalPathsFirstToMid.forEach(p => {
      const existing = inToMidConnections.find(c => c.inIdx === p.inIdx && c.midIdx === p.midIdx);
      if (existing) {
        existing.isSignal = true;
      } else {
        inToMidConnections.push({ inIdx: p.inIdx, midIdx: p.midIdx, isSignal: true });
      }
    });

    // Patch missing connections without removing existing ones
    layers[0].forEach((_, i) => {
      if (!inToMidConnections.some(c => c.inIdx === i)) {
        const randomMid = Math.floor(seededRandom() * layers[1].length);
        inToMidConnections.push({ inIdx: i, midIdx: randomMid, isSignal: false });
      }
    });
    layers[1].forEach((_, j) => {
      if (!inToMidConnections.some(c => c.midIdx === j)) {
        const randomIn = Math.floor(seededRandom() * layers[0].length);
        inToMidConnections.push({ inIdx: randomIn, midIdx: j, isSignal: false });
      }
    });

    const midToOutConnections: { midIdx: number; outIdx: number; isSignal: boolean }[] = [];

    layers[1].forEach((_, j) => {
      const connectedOutputIndices = getUniqueRandomIndices(layers[2].length, 2 + Math.floor(seededRandom() * 2));
      layers[2].forEach((_, k) => {
        const isSignalPath = signalPathsMidToOut.some(p => p.midIdx === j && p.outIdx === k);
        const isConnected = connectedOutputIndices.includes(k) || isSignalPath;
        if (isConnected) {
          if (!midToOutConnections.some(c => c.midIdx === j && c.outIdx === k)) {
            midToOutConnections.push({ midIdx: j, outIdx: k, isSignal: isSignalPath });
          }
        }
      });
    });

    signalPathsMidToOut.forEach(p => {
      const existing = midToOutConnections.find(c => c.midIdx === p.midIdx && c.outIdx === p.outIdx);
      if (existing) {
        existing.isSignal = true;
      } else {
        midToOutConnections.push({ midIdx: p.midIdx, outIdx: p.outIdx, isSignal: true });
      }
    });

    // Patch missing connections without removing existing ones
    layers[1].forEach((_, j) => {
      if (!midToOutConnections.some(c => c.midIdx === j)) {
        const randomOut = Math.floor(seededRandom() * layers[2].length);
        midToOutConnections.push({ midIdx: j, outIdx: randomOut, isSignal: false });
      }
    });
    layers[2].forEach((_, k) => {
      if (!midToOutConnections.some(c => c.outIdx === k)) {
        const randomMid = Math.floor(seededRandom() * layers[1].length);
        midToOutConnections.push({ midIdx: randomMid, outIdx: k, isSignal: false });
      }
    });

    let gradCounter = 0;
    const allRouteSegments: { x1: number; y1: number; x2: number; y2: number; isSignal: boolean; outEl?: HTMLElement }[] = [];

    inToMidConnections.forEach(conn => {
      const nodeA = layers[0][conn.inIdx];
      const nodeB = layers[1][conn.midIdx];

      const gradId = `c1-mid-${gradCounter++}`;
      const grad = document.createElementNS('http://www.w3.org/2000/svg', 'linearGradient');
      grad.setAttribute('id', gradId);
      grad.setAttribute('x1', String(nodeA.x));
      grad.setAttribute('y1', String(nodeA.y));
      grad.setAttribute('x2', String(nodeB.x));
      grad.setAttribute('y2', String(nodeB.y));
      grad.setAttribute('gradientUnits', 'userSpaceOnUse');

      const startOp = conn.isSignal ? '0.35' : '0.15';
      const endOp = conn.isSignal ? '0.65' : '0.35';
      const strokeWidth = conn.isSignal ? '1.1' : '0.75';

      const stop1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
      stop1.setAttribute('offset', '0%');
      stop1.setAttribute('stop-color', 'currentColor');
      stop1.setAttribute('stop-opacity', startOp);

      const stop2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
      stop2.setAttribute('offset', '100%');
      stop2.setAttribute('stop-color', 'currentColor');
      stop2.setAttribute('stop-opacity', endOp);

      grad.appendChild(stop1);
      grad.appendChild(stop2);
      defsEl.appendChild(grad);

      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', String(nodeA.x));
      line.setAttribute('y1', String(nodeA.y));
      line.setAttribute('x2', String(nodeB.x));
      line.setAttribute('y2', String(nodeB.y));
      line.setAttribute('stroke', `url(#${gradId})`);
      line.setAttribute('stroke-width', strokeWidth);

      connLayer.appendChild(line);

      allRouteSegments.push({
        x1: nodeA.x, y1: nodeA.y,
        x2: nodeB.x, y2: nodeB.y,
        isSignal: conn.isSignal
      });
    });

    const outputNodeElements: HTMLElement[] = [];
    const allNodeElements: HTMLElement[] = [];

    midToOutConnections.forEach(conn => {
      const nodeA = layers[1][conn.midIdx];
      const nodeB = layers[2][conn.outIdx];

      const gradId = `mid-out-${gradCounter++}`;
      const grad = document.createElementNS('http://www.w3.org/2000/svg', 'linearGradient');
      grad.setAttribute('id', gradId);
      grad.setAttribute('x1', String(nodeA.x));
      grad.setAttribute('y1', String(nodeA.y));
      grad.setAttribute('x2', String(nodeB.x));
      grad.setAttribute('y2', String(nodeB.y));
      grad.setAttribute('gradientUnits', 'userSpaceOnUse');

      const startOp = conn.isSignal ? '0.65' : '0.25';
      const endOp = conn.isSignal ? '0.90' : '0.40';
      const strokeWidth = conn.isSignal ? '1.1' : '0.75';

      const stop1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
      stop1.setAttribute('offset', '0%');
      stop1.setAttribute('stop-color', 'currentColor');
      stop1.setAttribute('stop-opacity', startOp);

      const stop2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
      stop2.setAttribute('offset', '100%');
      stop2.setAttribute('stop-color', 'currentColor');
      stop2.setAttribute('stop-opacity', endOp);

      grad.appendChild(stop1);
      grad.appendChild(stop2);
      defsEl.appendChild(grad);

      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', String(nodeA.x));
      line.setAttribute('y1', String(nodeA.y));
      line.setAttribute('x2', String(nodeB.x));
      line.setAttribute('y2', String(nodeB.y));
      line.setAttribute('stroke', `url(#${gradId})`);
      line.setAttribute('stroke-width', strokeWidth);

      connLayer.appendChild(line);

      const outEl = outputNodeElements[conn.outIdx];

      allRouteSegments.push({
        x1: nodeA.x, y1: nodeA.y,
        x2: nodeB.x, y2: nodeB.y,
        isSignal: conn.isSignal,
        outEl: outEl
      });
    });

    layers.forEach((layer, lIndex) => {
      layer.forEach((nodeData, nIndex) => {
        const nodeEl = document.createElement('div');
        
        if (nodeData.isOutput) {
          nodeEl.className = `node output-node ${nodeData.colorType}`;
          outputNodeElements.push(nodeEl);
        } else if (nodeData.isMiddle) {
          nodeEl.className = 'node middle-node';
          nodeEl.style.backgroundColor = nodeData.tone || getCssVar('--text-secondary');
        } else {
          nodeEl.className = 'node graduated-node';
          nodeEl.style.backgroundColor = nodeData.tone || getCssVar('--text-secondary');
          nodeEl.style.opacity = String(nodeData.opacity);
        }

        nodeEl.style.width = `${nodeData.size}px`;
        nodeEl.style.height = `${nodeData.size}px`;
        nodeEl.style.left = `${(nodeData.x / 1000) * 100}%`;
        nodeEl.style.top = `${(nodeData.y / 400) * 100}%`;

        htmlNodesContainer.appendChild(nodeEl);
        allNodeElements.push(nodeEl);
      });
    });

    function travelParticle(
      x1: number, y1: number, x2: number, y2: number, 
      duration: number, 
      isSignal: boolean, 
      onComplete?: () => void
    ) {
      const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      dot.setAttribute('r', isSignal ? '2.5' : '1.5');
      dot.setAttribute('fill', isSignal ? getCssVar('--accent-primary') : getCssVar('--text-muted'));
      dot.style.filter = isSignal ? 'drop-shadow(0 0 4px var(--accent-primary))' : 'none';
      pulsesLayer.appendChild(dot);

      const startTime = performance.now();

      function step(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);

        const currentX = x1 + (x2 - x1) * progress;
        const currentY = y1 + (y2 - y1) * progress;
        const currentOpacity = isSignal ? (0.3 + progress * 0.7) : (0.15 + progress * 0.4);

        dot.setAttribute('cx', String(currentX));
        dot.setAttribute('cy', String(currentY));
        dot.setAttribute('opacity', String(currentOpacity));

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          dot.remove();
          if (onComplete) onComplete();
        }
      }

      requestAnimationFrame(step);
    }

    function startLoadSweep() {
      if (prefersReducedMotion) {
        startBreathingAndPulses();
        return;
      }

      const sweepDuration = TIMINGS.loadSweepDurationMs;
      
      allRouteSegments.forEach(seg => {
        const startDelay = (seg.x1 / 1000) * (sweepDuration * 0.65);
        const segmentTravelTime = sweepDuration * 0.35;

        setTimeout(() => {
          travelParticle(seg.x1, seg.y1, seg.x2, seg.y2, segmentTravelTime, seg.isSignal, () => {
            if (seg.outEl && seg.x2 >= 950) {
              seg.outEl.classList.add('pulse-boost');
              setTimeout(() => {
                seg.outEl?.classList.remove('pulse-boost');
              }, 400);
            }
          });
        }, startDelay);
      });

      setTimeout(() => {
        startBreathingAndPulses();
      }, sweepDuration + 300);
    }

    function startBreathingAndPulses() {
      allNodeElements.forEach((nodeEl, nIndex) => {
        if (nodeEl.classList.contains('output-node')) {
          const cycleTime = TIMINGS.outputBreathingCycleMin + (nIndex * 0.2);
          nodeEl.style.animation = `outputBreathe ${cycleTime}s ease-in-out infinite ${nIndex * 0.5}s`;
        } else if (nodeEl.classList.contains('middle-node')) {
          nodeEl.style.animation = `middleWaveBreathe ${TIMINGS.middleWaveBreathingCycle}s ease-in-out infinite ${nIndex * 0.35}s`;
        } else {
          nodeEl.style.animation = `subtleBreathe ${TIMINGS.subtleBreathingCycle}s ease-in-out infinite`;
        }
      });

      if (!prefersReducedMotion) {
        function triggerPulseBatch() {
          const count = Math.floor(TIMINGS.pulseBatchMinCount + Math.random() * (TIMINGS.pulseBatchMaxCount - TIMINGS.pulseBatchMinCount + 1));
          
          for (let i = 0; i < count; i++) {
            const staggerDelay = Math.random() * TIMINGS.pulseBatchStaggerMaxMs;

            setTimeout(() => {
              const seg = allRouteSegments[Math.floor(Math.random() * allRouteSegments.length)];
              
              travelParticle(seg.x1, seg.y1, seg.x2, seg.y2, TIMINGS.pulseTravelDurationMs, seg.isSignal, () => {
                if (seg.isSignal && seg.outEl) {
                  seg.outEl.classList.add('pulse-boost');
                  setTimeout(() => {
                    seg.outEl?.classList.remove('pulse-boost');
                  }, 400);
                }
              });
            }, staggerDelay);
          }

          const nextInterval = TIMINGS.pulseIntervalMinMs + Math.random() * (TIMINGS.pulseIntervalMaxMs - TIMINGS.pulseIntervalMinMs);
          setTimeout(triggerPulseBatch, nextInterval);
        }

        const initialDelay = TIMINGS.pulseIntervalMinMs + Math.random() * 2000;
        setTimeout(triggerPulseBatch, initialDelay);
      }
    }

    startLoadSweep();
  }

  initHeroBand();
  window.addEventListener('resize', initHeroBand);
  document.addEventListener('astro:after-swap', initHeroBand);
</script>

<style is:global>
  @keyframes outputBreathe {
    0%, 100% {
      opacity: 0.5;
      box-shadow: 0 0 0px var(--glow-color);
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      box-shadow: 0 0 10px var(--glow-color);
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  .output-node.pulse-boost {
    opacity: 1 !important;
    transform: translate(-50%, -50%) scale(1.25) !important;
    box-shadow: 0 0 16px var(--glow-color) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @keyframes middleWaveBreathe {
    0%, 100% {
      opacity: 0.45;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.05);
    }
  }

  @keyframes subtleBreathe {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.04);
    }
  }

  .node {
    position: absolute;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .graduated-node {
    animation-name: subtleBreathe;
    animation-duration: 5s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .middle-node {
    animation-name: middleWaveBreathe;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .output-node {
    width: 8px !important;
    height: 8px !important;
    animation-name: outputBreathe;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .output-node.gray {
    background-color: var(--text-primary);
    --glow-color: var(--text-muted);
  }

  .output-node.denim {
    background-color: var(--accent-primary);
    --glow-color: var(--accent-primary);
  }

  .output-node.camel {
    background-color: var(--accent-secondary);
    --glow-color: var(--accent-secondary);
  }
</style>

<style>
  .hero-section {
    position: relative;
    background-color: var(--bg-primary);
  }

  .hero-network-band {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 1.5rem;
    right: 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    height: 400px;
    z-index: 1;
    pointer-events: none;
  }

  #hero-band-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .html-nodes-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    height: 100%;
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    max-width: 540px;
  }

  .name-title {
    font-size: 3rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 2rem;
  }

  .hero-body {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  /* Two-row keyword tags styling */
  .keyword-tags-container {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    align-items: flex-start;
  }

  .keyword-row {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .tag.tag-1 { background-color: var(--tag-1-bg); color: var(--tag-1-text); }
  .tag.tag-2 { background-color: var(--tag-2-bg); color: var(--tag-2-text); }
  .tag.tag-3 { background-color: var(--tag-3-bg); color: var(--tag-3-text); }
  .tag.tag-4 { background-color: var(--tag-4-bg); color: var(--tag-4-text); }
  .tag.tag-5 { background-color: var(--tag-5-bg); color: var(--tag-5-text); }

  .tag:hover {
    color: var(--accent-primary);
  }

  @media (max-width: 768px) {
    .name-title {
      font-size: 2.25rem;
    }
    .keyword-row {
      flex-wrap: wrap;
    }
  }
</style>