  }

  .node.is-animating.middle-node {
    animation: middleWaveBreathe 5.5s ease-in-out infinite;
  }

  .node.is-animating.output-node {
    animation: outputBreathe var(--breathe-duration, 3.5s) ease-in-out infinite;
