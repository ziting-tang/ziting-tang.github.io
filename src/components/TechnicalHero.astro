  @keyframes outputBreathe {
    0%, 100% {
      opacity: 0.5;
      box-shadow: 0 0 0px var(--glow-color);
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      box-shadow: 0 0 10px var(--glow-color);
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  .output-node.pulse-boost {
    opacity: 1 !important;
    transform: translate(-50%, -50%) scale(1.25) !important;
    box-shadow: 0 0 16px var(--glow-color) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @keyframes middleWaveBreathe {
    0%, 100% {
      opacity: 0.45;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.05);
    }
  }

  @keyframes subtleBreathe {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.04);
    }
  }

  /* 1. 初始状态：确保刚创建时绝对隐形 */
  .node,
  .node.graduated-node,
  .node.middle-node,
  .node.output-node {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.85);
    pointer-events: none;
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  /* 2. 第一步：触发淡入 */
  .node.is-visible {
    opacity: var(--target-opacity, 1);
    transform: translate(-50%, -50%) scale(1);
  }

  /* 3. 第二步：只有加上 .is-animating 后才开始呼吸 */
