---
/* 
  src/components/figures/NotesFigure.astro
  Notes section illustration: cluster set diameters (Δ₁, Δ₂) and distance (δ).
*/
---
<svg viewBox="0 0 700 340" width="100%" height="100%" class="conceptual-svg" aria-label="Cluster size and separation diagram">
  <!-- Cluster 1 Circle & Diameter Line -->
  <circle cx="230" cy="160" r="70" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="3,3" opacity="0.45"/>
  <line x1="160" y1="160" x2="300" y2="160" stroke="currentColor" stroke-width="1" opacity="0.4" />
  
  <g fill="currentColor" opacity="0.85">
    <circle cx="210" cy="135" r="4.5"/><circle cx="245" cy="125" r="4"/><circle cx="225" cy="180" r="5"/><circle cx="265" cy="155" r="4.5"/><circle cx="195" cy="170" r="3.5"/>
  </g>

  <!-- Cluster 2 Circle & Diameter Line -->
  <circle cx="470" cy="175" r="80" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="3,3" opacity="0.45"/>
  <line x1="390" y1="175" x2="550" y2="175" stroke="currentColor" stroke-width="1" opacity="0.4" />

  <g fill="currentColor" opacity="0.85">
    <circle cx="445" cy="150" r="4.5"/><circle cx="485" cy="195" r="5"/><circle cx="510" cy="165" r="4"/><circle cx="430" cy="190" r="4.5"/><circle cx="480" cy="140" r="3.5"/>
  </g>

  <!-- Inter-cluster Distance Dashed Line (δ) -->
  <line x1="300" y1="160" x2="390" y2="175" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6,4" opacity="0.75"/>
  
  <g fill="currentColor" font-family="var(--font-mono)" font-size="12">
    <text x="335" y="150">δ</text>
    <text x="220" y="152" opacity="0.7">Δ₁</text>
    <text x="460" y="167" opacity="0.7">Δ₂</text>
  </g>

  <g fill="currentColor" font-family="var(--font-mono)" font-size="10.5" opacity="0.6" letter-spacing="0.05em">
    <text x="210" y="275">clusters</text>
  </g>
</svg>