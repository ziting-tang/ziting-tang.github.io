---
/* 
  src/components/figures/ResearchFigure.astro
  Research section illustration: multimodal pipeline.
*/
---
<svg viewBox="0 0 700 340" width="100%" height="100%" class="conceptual-svg" aria-label="Pipeline conceptual diagram">
  <!-- Left: Imaging Grid & Omics Bars -->
  <g stroke="currentColor" stroke-width="1.25" fill="none">
    <rect x="50" y="110" width="28" height="28" rx="2" stroke-dasharray="3,3" opacity="0.5"/>
    <rect x="85" y="110" width="28" height="28" rx="2" opacity="0.75"/>
    <rect x="50" y="145" width="28" height="28" rx="2" opacity="0.75"/>
    <rect x="85" y="145" width="28" height="28" rx="2" stroke-dasharray="3,3" opacity="0.5"/>
    <rect x="145" y="100" width="7" height="95" rx="1" fill="currentColor" opacity="0.4"/>
    <rect x="157" y="85" width="7" height="125" rx="1" fill="currentColor" opacity="0.7"/>
    <rect x="169" y="115" width="7" height="65" rx="1" fill="currentColor" opacity="0.3"/>
  </g>

  <!-- Connecting Line -->
  <g stroke="currentColor" stroke-width="1.25" opacity="0.4" stroke-dasharray="4,4">
    <line x1="205" y1="147" x2="280" y2="147" />
  </g>

  <!-- Middle: Neural Network Model -->
  <g fill="var(--bg-surface)" stroke="currentColor" stroke-width="1.5">
    <circle cx="310" cy="110" r="7"/>
    <circle cx="310" cy="147" r="7"/>
    <circle cx="310" cy="184" r="7"/>
    <circle cx="395" cy="128" r="7"/>
    <circle cx="395" cy="166" r="7"/>
    <line x1="317" y1="110" x2="388" y2="128" stroke="currentColor" stroke-width="1" opacity="0.45"/>
    <line x1="317" y1="147" x2="388" y2="128" stroke="currentColor" stroke-width="1" opacity="0.45"/>
    <line x1="317" y1="147" x2="388" y2="166" stroke="currentColor" stroke-width="1" opacity="0.45"/>
    <line x1="317" y1="184" x2="388" y2="166" stroke="currentColor" stroke-width="1" opacity="0.45"/>
  </g>

  <!-- Right: Clusters -->
  <g stroke="currentColor" stroke-width="1.25" opacity="0.4" stroke-dasharray="4,4">
    <line x1="425" y1="147" x2="500" y2="147" />
  </g>
  <g fill="currentColor">
    <circle cx="560" cy="95" r="4.5" opacity="0.8"/>
    <circle cx="585" cy="115" r="4" opacity="0.6"/>
    <circle cx="545" cy="125" r="5" opacity="0.7"/>
    <circle cx="570" cy="85" r="3.5" opacity="0.5"/>
    <circle cx="580" cy="210" r="5" opacity="0.8"/>
    <circle cx="605" cy="190" r="4" opacity="0.7"/>
    <circle cx="560" cy="200" r="4.5" opacity="0.6"/>
  </g>

  <!-- Lowercase Annotations -->
  <g fill="currentColor" font-family="var(--font-mono)" font-size="10.5" opacity="0.6" letter-spacing="0.05em">
    <text x="50" y="235">imaging + omics</text>
    <text x="325" y="235">model</text>
    <text x="545" y="255">clusters</text>
  </g>
</svg>